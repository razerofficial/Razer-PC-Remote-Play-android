<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <!--
        for some reason, the @android:id/mask needs an extra 8dp for it to be
        positioned directly above the m3_ex_circle_shape_background
    -->
    <item
        android:id="@android:id/mask"
        android:drawable="@drawable/m3_ex_circle_mask" />
    <item>
        <layer-list>
            <item
                android:drawable="@drawable/m3_ex_circle_shape_background" />
            <item
                android:drawable="@drawable/ic_back"
                android:gravity="center" />
        </layer-list>
    </item>
</ripple>