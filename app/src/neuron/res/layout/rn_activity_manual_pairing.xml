<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/RnSettingBackground">

    <View
        android:layout_marginStart="@dimen/m3_edittext_activity_margin_start"
        android:id="@+id/start_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="0dp"
        android:layout_height="0dp"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_tool_bar"
        style="@style/RnM3ExToolbar"
        android:background="@android:color/transparent"
        android:touchscreenBlocksFocus="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleTextAppearance="@style/TextAppearance.Material3.Toolbar.Title"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_mid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".62" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_ip_address"
        style="@style/RnTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/top_tool_bar"
        app:layout_constraintStart_toStartOf="@+id/start_margin"
        app:layout_constraintEnd_toStartOf="@+id/guideline_mid"
        android:layout_marginStart="@dimen/margin_4x"
        android:layout_marginEnd="@dimen/margin_4x"
        android:hint="@string/rn_hint_input_pc_ip_address"
        app:helperText="@string/rn_ip_helper_text"
        app:endIconMode="clear_text"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ip_address"
            style="@style/RnTextInputEditText"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:nextFocusForward="@id/til_port"
            android:singleLine="true"
            android:maxLines="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_port"
        style="@style/RnTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/guideline_mid"
        app:layout_constraintTop_toBottomOf="@+id/top_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/margin_8x"
        android:hint="@string/rn_hint_input_pc_port"
        app:helperText="@string/rn_port_helper_text"
        app:endIconMode="clear_text"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_port"
            style="@style/RnTextInputEditText"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:singleLine="true"
            android:maxLines="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/RnButtonStyle.Outlined"
        android:layout_marginEnd="@dimen/margin_8x"
        app:layout_constraintEnd_toEndOf="@+id/top_tool_bar"
        app:layout_constraintTop_toTopOf="@+id/top_tool_bar"
        app:layout_constraintBottom_toBottomOf="@+id/top_tool_bar"
        android:text="@string/rn_add"
        tools:visibility="visible"
        android:focusable="true" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/rn_layout_loading"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
